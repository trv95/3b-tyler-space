{
  "get": {
    "summary": "List service owners and routing",
    "description": "Returns service-ownership and ticket-routing records. All query params are optional filters (exact match).",
    "parameters": [
      {"name":"service","in":"query","schema":{"type":"string"},"description":"Service key, e.g. atlaspay-checkout-uat"},
      {"name":"ownerEmail","in":"query","schema":{"type":"string"}},
      {"name":"target","in":"query","schema":{"type":"string"},"description":"Ticketing target (BugDB, Jira, Enterprise Jira)"},
      {"name":"application","in":"query","schema":{"type":"string"}},
      {"name":"project","in":"query","schema":{"type":"string"}},
      {"name":"limit","in":"query","schema":{"type":"integer","default":100,"maximum":500}}
    ],
    "responses": {
      "200": {
        "description": "Matching owner records",
        "content": {"application/json": {"schema": {
          "type":"object",
          "properties":{
            "count":{"type":"integer"},
            "records":{"type":"array","items":{"type":"object","properties":{
              "application":{"type":"string"},"service":{"type":"string"},"owner":{"type":"string"},
              "ownerEmail":{"type":"string"},"spoc":{"type":"string"},"spocEmail":{"type":"string"},
              "target":{"type":"string"},"project":{"type":"string"},"slack":{"type":"string"},"component":{"type":"string"}
            }}}
          }
        }}}
      }
    }
  },
  "post": {
    "summary": "Insert or update owner records (upsert)",
    "description": "Upserts owner records keyed on `service`. If a row with the same `service` exists it is updated (only the provided columns change), otherwise a new row is inserted. Accepts a single record object or {\"records\":[...]} for batch. Unknown fields are ignored; each record must include a non-empty `service`.",
    "requestBody": {
      "required": true,
      "content": {"application/json": {"schema": {
        "oneOf": [
          {"$comment":"single record","type":"object","required":["service"],"properties":{
            "application":{"type":"string"},"service":{"type":"string"},"owner":{"type":"string"},
            "ownerEmail":{"type":"string"},"spoc":{"type":"string"},"spocEmail":{"type":"string"},
            "target":{"type":"string"},"project":{"type":"string"},"slack":{"type":"string"},"component":{"type":"string"}
          }},
          {"$comment":"batch","type":"object","required":["records"],"properties":{"records":{"type":"array","items":{
            "type":"object","required":["service"],"properties":{
              "application":{"type":"string"},"service":{"type":"string"},"owner":{"type":"string"},
              "ownerEmail":{"type":"string"},"spoc":{"type":"string"},"spocEmail":{"type":"string"},
              "target":{"type":"string"},"project":{"type":"string"},"slack":{"type":"string"},"component":{"type":"string"}
            }}}}}
        ]
      }}}
    },
    "responses": {
      "200": {"description":"Upsert result","content":{"application/json":{"schema":{"type":"object","properties":{
        "ok":{"type":"boolean"},"inserted":{"type":"integer"},"updated":{"type":"integer"},
        "keys":{"type":"array","items":{"type":"string"}}}}}}},
      "400": {"description":"Invalid body or missing key","content":{"application/json":{"schema":{"type":"object","properties":{
        "ok":{"type":"boolean"},"error":{"type":"string"}}}}}}
    }
  }
}
