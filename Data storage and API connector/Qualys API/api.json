{
  "get": {
    "summary": "List Qualys findings",
    "description": "Returns Qualys scan findings. All query params are optional filters; service/ownerEmail/priority/risk/qid/bug/findingId/target/asset are exact match, cve and title are substring (LIKE) match.",
    "parameters": [
      {"name":"service","in":"query","schema":{"type":"string"}},
      {"name":"ownerEmail","in":"query","schema":{"type":"string"}},
      {"name":"priority","in":"query","schema":{"type":"string"},"description":"P0, P2, P3"},
      {"name":"risk","in":"query","schema":{"type":"string"},"description":"High, Medium, Needs Review"},
      {"name":"qid","in":"query","schema":{"type":"string"}},
      {"name":"bug","in":"query","schema":{"type":"string"}},
      {"name":"findingId","in":"query","schema":{"type":"string"}},
      {"name":"target","in":"query","schema":{"type":"string"}},
      {"name":"asset","in":"query","schema":{"type":"string"}},
      {"name":"cve","in":"query","schema":{"type":"string"},"description":"Substring match"},
      {"name":"title","in":"query","schema":{"type":"string"},"description":"Substring match"},
      {"name":"limit","in":"query","schema":{"type":"integer","default":100,"maximum":500}}
    ],
    "responses": {
      "200": {
        "description": "Matching Qualys findings",
        "content": {"application/json": {"schema": {
          "type":"object",
          "properties":{
            "count":{"type":"integer"},
            "records":{"type":"array","items":{"type":"object","properties":{
              "findingId":{"type":"string"},"qid":{"type":"string"},"priority":{"type":"string"},
              "risk":{"type":"string"},"title":{"type":"string"},"cve":{"type":"string"},
              "asset":{"type":"string"},"service":{"type":"string"},"ownerEmail":{"type":"string"},
              "target":{"type":"string"},"bug":{"type":"string"},"securityCentral":{"type":"string"},
              "remediation":{"type":"string"}
            }}}
          }
        }}}
      }
    }
  },
  "post": {
    "summary": "Insert or update Qualys findings (upsert)",
    "description": "Upserts Qualys findings keyed on `findingId`. If a row with the same `findingId` exists it is updated (only the provided columns change), otherwise a new row is inserted. Accepts a single record object or {\"records\":[...]} for batch. Unknown fields are ignored; each record must include a non-empty `findingId`.",
    "requestBody": {
      "required": true,
      "content": {"application/json": {"schema": {
        "oneOf": [
          {"$comment":"single record","type":"object","required":["findingId"],"properties":{
            "findingId":{"type":"string"},"qid":{"type":"string"},"priority":{"type":"string"},
            "risk":{"type":"string"},"title":{"type":"string"},"cve":{"type":"string"},
            "asset":{"type":"string"},"service":{"type":"string"},"ownerEmail":{"type":"string"},
            "target":{"type":"string"},"bug":{"type":"string"},"securityCentral":{"type":"string"},
            "remediation":{"type":"string"}
          }},
          {"$comment":"batch","type":"object","required":["records"],"properties":{"records":{"type":"array","items":{
            "type":"object","required":["findingId"],"properties":{
              "findingId":{"type":"string"},"qid":{"type":"string"},"priority":{"type":"string"},
              "risk":{"type":"string"},"title":{"type":"string"},"cve":{"type":"string"},
              "asset":{"type":"string"},"service":{"type":"string"},"ownerEmail":{"type":"string"},
              "target":{"type":"string"},"bug":{"type":"string"},"securityCentral":{"type":"string"},
              "remediation":{"type":"string"}
            }}}}}
        ]
      }}}
    },
    "responses": {
      "200": {"description":"Upsert result","content":{"application/json":{"schema":{"type":"object","properties":{
        "ok":{"type":"boolean"},"inserted":{"type":"integer"},"updated":{"type":"integer"},
        "keys":{"type":"array","items":{"type":"string"}}}}}}},
      "400": {"description":"Invalid body or missing key","content":{"application/json":{"schema":{"type":"object","properties":{
        "ok":{"type":"boolean"},"error":{"type":"string"}}}}}}
    }
  }
}
