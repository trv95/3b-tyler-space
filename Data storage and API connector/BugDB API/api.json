{
  "get": {
    "summary": "List BugDB tickets",
    "description": "Returns BugDB mock tickets. All query params are optional filters; bug/priority/risk/status/product/component/ownerEmail/source/sourceFinding/securityCentral are exact match, cve and subject are substring (LIKE) match.",
    "parameters": [
      {"name":"bug","in":"query","schema":{"type":"string"}},
      {"name":"priority","in":"query","schema":{"type":"string"}},
      {"name":"risk","in":"query","schema":{"type":"string"}},
      {"name":"status","in":"query","schema":{"type":"string"}},
      {"name":"product","in":"query","schema":{"type":"string"}},
      {"name":"component","in":"query","schema":{"type":"string"}},
      {"name":"ownerEmail","in":"query","schema":{"type":"string"}},
      {"name":"source","in":"query","schema":{"type":"string"}},
      {"name":"sourceFinding","in":"query","schema":{"type":"string"}},
      {"name":"securityCentral","in":"query","schema":{"type":"string"}},
      {"name":"cve","in":"query","schema":{"type":"string"},"description":"Substring match"},
      {"name":"subject","in":"query","schema":{"type":"string"},"description":"Substring match"},
      {"name":"limit","in":"query","schema":{"type":"integer","default":100,"maximum":500}}
    ],
    "responses": {
      "200": {
        "description": "Matching BugDB tickets",
        "content": {"application/json": {"schema": {
          "type":"object",
          "properties":{
            "count":{"type":"integer"},
            "records":{"type":"array","items":{"type":"object","properties":{
              "bug":{"type":"string"},"priority":{"type":"string"},"risk":{"type":"string"},
              "severity":{"type":"integer"},"status":{"type":"string"},"subject":{"type":"string"},
              "product":{"type":"string"},"component":{"type":"string"},"owner":{"type":"string"},
              "ownerEmail":{"type":"string"},"slack":{"type":"string"},"source":{"type":"string"},
              "sourceFinding":{"type":"string"},"securityCentral":{"type":"string"},
              "cve":{"type":"string"},"remediation":{"type":"string"}
            }}}
          }
        }}}
      }
    }
  },
  "post": {
    "summary": "Insert or update BugDB tickets (upsert)",
    "description": "Upserts BugDB tickets keyed on `bug`. If a row with the same `bug` exists it is updated (only the provided columns change), otherwise a new row is inserted. Accepts a single record object or {\"records\":[...]} for batch. Unknown fields are ignored; each record must include a non-empty `bug`.",
    "requestBody": {
      "required": true,
      "content": {"application/json": {"schema": {
        "oneOf": [
          {"$comment":"single record","type":"object","required":["bug"],"properties":{
            "bug":{"type":"string"},"priority":{"type":"string"},"risk":{"type":"string"},
            "severity":{"type":"integer"},"status":{"type":"string"},"subject":{"type":"string"},
            "product":{"type":"string"},"component":{"type":"string"},"owner":{"type":"string"},
            "ownerEmail":{"type":"string"},"slack":{"type":"string"},"source":{"type":"string"},
            "sourceFinding":{"type":"string"},"securityCentral":{"type":"string"},
            "cve":{"type":"string"},"remediation":{"type":"string"}
          }},
          {"$comment":"batch","type":"object","required":["records"],"properties":{"records":{"type":"array","items":{
            "type":"object","required":["bug"],"properties":{
              "bug":{"type":"string"},"priority":{"type":"string"},"risk":{"type":"string"},
              "severity":{"type":"integer"},"status":{"type":"string"},"subject":{"type":"string"},
              "product":{"type":"string"},"component":{"type":"string"},"owner":{"type":"string"},
              "ownerEmail":{"type":"string"},"slack":{"type":"string"},"source":{"type":"string"},
              "sourceFinding":{"type":"string"},"securityCentral":{"type":"string"},
              "cve":{"type":"string"},"remediation":{"type":"string"}
            }}}}}
        ]
      }}}
    },
    "responses": {
      "200": {"description":"Upsert result","content":{"application/json":{"schema":{"type":"object","properties":{
        "ok":{"type":"boolean"},"inserted":{"type":"integer"},"updated":{"type":"integer"},
        "keys":{"type":"array","items":{"type":"string"}}}}}}},
      "400": {"description":"Invalid body or missing key","content":{"application/json":{"schema":{"type":"object","properties":{
        "ok":{"type":"boolean"},"error":{"type":"string"}}}}}}
    }
  }
}
