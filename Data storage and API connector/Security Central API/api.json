{
  "get": {
    "summary": "List Security Central findings",
    "description": "Returns Security Central finding records. All query params are optional filters; service/ownerEmail/severity/status/qid/bug/securityCentralId/resource/region are exact match, cve and summary are substring (LIKE) match.",
    "parameters": [
      {"name":"service","in":"query","schema":{"type":"string"}},
      {"name":"ownerEmail","in":"query","schema":{"type":"string"}},
      {"name":"severity","in":"query","schema":{"type":"string"},"description":"HIGH, MEDIUM, NEEDS REVIEW"},
      {"name":"status","in":"query","schema":{"type":"string"}},
      {"name":"qid","in":"query","schema":{"type":"string"}},
      {"name":"bug","in":"query","schema":{"type":"string"}},
      {"name":"securityCentralId","in":"query","schema":{"type":"string"}},
      {"name":"resource","in":"query","schema":{"type":"string"}},
      {"name":"region","in":"query","schema":{"type":"string"}},
      {"name":"cve","in":"query","schema":{"type":"string"},"description":"Substring match"},
      {"name":"summary","in":"query","schema":{"type":"string"},"description":"Substring match"},
      {"name":"limit","in":"query","schema":{"type":"integer","default":100,"maximum":500}}
    ],
    "responses": {
      "200": {
        "description": "Matching Security Central findings",
        "content": {"application/json": {"schema": {
          "type":"object",
          "properties":{
            "count":{"type":"integer"},
            "records":{"type":"array","items":{"type":"object","properties":{
              "securityCentralId":{"type":"string"},"severity":{"type":"string"},"status":{"type":"string"},
              "summary":{"type":"string"},"qid":{"type":"string"},"cve":{"type":"string"},
              "resource":{"type":"string"},"service":{"type":"string"},"ownerEmail":{"type":"string"},
              "bug":{"type":"string"},"region":{"type":"string"},"reported":{"type":"string"}
            }}}
          }
        }}}
      }
    }
  },
  "post": {
    "summary": "Insert or update Security Central findings (upsert)",
    "description": "Upserts Security Central findings keyed on `securityCentralId`. If a row with the same `securityCentralId` exists it is updated (only the provided columns change), otherwise a new row is inserted. Accepts a single record object or {\"records\":[...]} for batch. Unknown fields are ignored; each record must include a non-empty `securityCentralId`.",
    "requestBody": {
      "required": true,
      "content": {"application/json": {"schema": {
        "oneOf": [
          {"$comment":"single record","type":"object","required":["securityCentralId"],"properties":{
            "securityCentralId":{"type":"string"},"severity":{"type":"string"},"status":{"type":"string"},
            "summary":{"type":"string"},"qid":{"type":"string"},"cve":{"type":"string"},
            "resource":{"type":"string"},"service":{"type":"string"},"ownerEmail":{"type":"string"},
            "bug":{"type":"string"},"region":{"type":"string"},"reported":{"type":"string"}
          }},
          {"$comment":"batch","type":"object","required":["records"],"properties":{"records":{"type":"array","items":{
            "type":"object","required":["securityCentralId"],"properties":{
              "securityCentralId":{"type":"string"},"severity":{"type":"string"},"status":{"type":"string"},
              "summary":{"type":"string"},"qid":{"type":"string"},"cve":{"type":"string"},
              "resource":{"type":"string"},"service":{"type":"string"},"ownerEmail":{"type":"string"},
              "bug":{"type":"string"},"region":{"type":"string"},"reported":{"type":"string"}
            }}}}}
        ]
      }}}
    },
    "responses": {
      "200": {"description":"Upsert result","content":{"application/json":{"schema":{"type":"object","properties":{
        "ok":{"type":"boolean"},"inserted":{"type":"integer"},"updated":{"type":"integer"},
        "keys":{"type":"array","items":{"type":"string"}}}}}}},
      "400": {"description":"Invalid body or missing key","content":{"application/json":{"schema":{"type":"object","properties":{
        "ok":{"type":"boolean"},"error":{"type":"string"}}}}}}
    }
  }
}
